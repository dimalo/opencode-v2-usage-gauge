{
  "name": "opencode-go-usage",
  "version": "0.1.0",
  "description": "OpenCode plugin: show OpenCode Go subscription usage in the TUI (prompt footer gauge + /usage command), only while an opencode-go model is active",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-go",
    "plugin",
    "usage",
    "widget"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@opencode/theme": "~2.0.18",
    "@opentui/core": "~0.5.12",
    "@opentui/solid": "~0.5.12",
    "@types/node": "^22.0.0",
    "solid-js": "~1.9.12",
    "typescript": "^5.7.0"
  }
}
